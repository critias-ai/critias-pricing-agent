# Credentials stay local. Never commit .env or paste credentials.
# Leave unset if you use Pi's supported stored OpenRouter credentials.
OPENROUTER_API_KEY=
# Direct OpenAI endpoint: set model.provider to "openai" (or PRICING_PROVIDER=openai) and the model id, e.g. gpt-6-luna.
OPENAI_API_KEY=

# Edit harness.config.json for model, reasoning, budgets and evaluation settings.
# The launcher supplies workspace and Python paths. An optional second launcher
# argument overrides the app model for that launch only.
# Optional alternative config path (relative to current directory or absolute):
# PRICING_CONFIG_FILE=/absolute/path/to/harness.config.json

# Existing PRICING_* environment settings remain explicit overrides.
# Remove stale model/budget overrides from .env when using the JSON settings file.
