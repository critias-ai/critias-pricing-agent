# Credentials stay local. Never commit .env or paste credentials.
# Set a key and a model for the provider you use. The app picks the first provider that has both,
# in this order: OpenAI, OpenRouter, Gemini (Google AI Studio), Anthropic.
# OpenAI also works with a stored "Sign in with ChatGPT" login: set only OPENAI_MODEL.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Optional: force one provider and model, for example in scripts. A launcher's second argument sets PRICING_MODEL.
# PRICING_PROVIDER=anthropic
# PRICING_MODEL=claude-sonnet-5-5
# Optional starting thinking level. The selector beside Send changes it per question. Default: medium.
# PRICING_THINKING_LEVEL=medium

# Edit harness.config.json for the port, upload cap, DuckDB limits, per-question budgets and evaluation settings.
# The launcher supplies workspace and Python paths.
# Optional alternative config path (relative to current directory or absolute):
# PRICING_CONFIG_FILE=/absolute/path/to/harness.config.json

# Environment settings override harness.config.json. Remove stale overrides from .env when editing the file.
