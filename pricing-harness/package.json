{
  "name": "critias",
  "version": "0.5.1",
  "description": "Local AI-assisted pricing and gross margin analysis with DuckDB and verified in-chat exploration.",
  "homepage": "https://critias.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/critias-ai/critias-pricing-agent.git",
    "directory": "pricing-harness"
  },
  "bugs": {
    "url": "https://github.com/critias-ai/critias-pricing-agent/issues"
  },
  "keywords": [
    "pricing",
    "pricing-analytics",
    "gross-margin",
    "price-volume-mix",
    "duckdb",
    "agent-skills",
    "local-first"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "critias": "bin/critias.mjs"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "dist",
    "bundled/**/*.md",
    "bundled/**/*.py",
    "bundled/**/*.json",
    "bundled/pricing-plugin/LICENSE",
    "requirements.txt",
    "package-lock.json",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    ".env.example",
    "docs/local-setup.md",
    "docs/data-dictionary.md",
    "docs/architecture.md",
    "scripts/setup-macos.sh",
    "scripts/start-macos.sh",
    "docs/acceptance.md",
    "npm-shrinkwrap.json",
    "harness.config.json",
    "bin",
    "scripts/setup-windows.ps1",
    "scripts/start-windows.ps1",
    "scripts/list-models.mjs"
  ],
  "scripts": {
    "dev": "tsx src/server.ts",
    "dev:ui": "vite",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "node dist/server.js",
    "models": "node scripts/list-models.mjs",
    "headless": "tsx src/headless.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"tests/**/*.ts\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"tests/**/*.ts\" \"scripts/**/*.mjs\"",
    "test": "vitest run",
    "test:python": ".venv/bin/python -m pytest tests/python -q",
    "test:browser": "playwright test",
    "test:scale": ".venv/bin/python -m pytest tests/perf -q",
    "eval": "tsx tests/evals/run.ts",
    "eval:oracle": "tsx tests/evals/run.ts --oracle",
    "eval:configured": "node scripts/eval-configured.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@assistant-ui/react": "0.15.22",
    "@assistant-ui/react-markdown": "0.14.23",
    "@earendil-works/chord": "1.0.4",
    "@earendil-works/pi-agent-core": "1.0.4",
    "@earendil-works/pi-ai": "1.0.4",
    "@earendil-works/pi-codemode": "1.0.4",
    "@earendil-works/pi-coding-agent": "1.0.4",
    "@earendil-works/pi-mcp": "1.0.4",
    "@earendil-works/pi-telemetry": "1.0.4",
    "@earendil-works/pi-tui": "1.0.4",
    "@fastify/multipart": "9.4.0",
    "@fastify/static": "8.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@fontsource/spectral": "5.3.0",
    "@fontsource/spline-sans-mono": "5.3.0",
    "fastify": "5.12.5",
    "mermaid": "12.0.0",
    "playwright": "1.63.0",
    "plotly.js-basic-dist-min": "4.1.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
