{
  "name": "pricing-harness",
  "version": "0.1.0",
  "description": "Local AI-assisted pricing and gross margin analysis with DuckDB and verified in-chat exploration.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "dist",
    "bundled/**/*.md",
    "bundled/**/*.py",
    "bundled/**/*.json",
    "bundled/pricing-plugin/LICENSE",
    "requirements.txt",
    "package-lock.json",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    ".env.example",
    "docs/local-setup.md",
    "docs/data-dictionary.md",
    "docs/architecture.md",
    "scripts/setup-macos.sh",
    "scripts/start-macos.sh",
    "docs/acceptance.md",
    "npm-shrinkwrap.json",
    "harness.config.json"
  ],
  "scripts": {
    "dev": "tsx src/server.ts",
    "dev:ui": "vite",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "node dist/server.js",
    "headless": "tsx src/headless.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"tests/**/*.ts\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"tests/**/*.ts\" \"scripts/**/*.mjs\"",
    "test": "vitest run",
    "test:python": ".venv/bin/python -m pytest tests/python -q",
    "test:browser": "playwright test",
    "test:scale": ".venv/bin/python -m pytest tests/perf -q",
    "eval": "tsx tests/evals/run.ts",
    "eval:oracle": "tsx tests/evals/run.ts --oracle",
    "eval:configured": "node scripts/eval-configured.mjs"
  },
  "dependencies": {
    "@assistant-ui/react": "0.15.22",
    "@assistant-ui/react-markdown": "0.14.17",
    "@earendil-works/pi-coding-agent": "1.0.4",
    "@fastify/multipart": "^9.0.0",
    "@fastify/static": "^8.0.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@fontsource/spectral": "5.3.0",
    "@fontsource/spline-sans-mono": "5.3.0",
    "fastify": "^5.0.0",
    "mermaid": "12.0.0",
    "playwright": "^1.55.0",
    "plotly.js-basic-dist-min": "4.1.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "3.3.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
